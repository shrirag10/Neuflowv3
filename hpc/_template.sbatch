#!/bin/bash
#SBATCH --job-name={job}
#SBATCH --partition=gpu
#SBATCH --gres=gpu:h200:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --time=08:00:00
#SBATCH --output=%x_%j.log

# Generated by hpc/make_sbatch.py -- edit that, not this, so every run stays
# identical except for the one variable under study.
#
# Fixed across ALL runs (so comparisons mean something):
#   seed 1234 | batch 16 | lr 2e-4 OneCycle | gamma 0.8
#   refinement 1 x s16 + 8 x s8   <- must match the eval default
#   4096 sparse queries, no jitter, convex head, backbone frozen (BN held in eval)
# Varying: {vary}

set -e
export PYTHONNOUSERSITE=1
PY=$HOME/.conda/envs/neuflow/bin/python3
$PY -c "import torch" || {{ echo "ENV BROKEN: $PY lacks torch" >&2; exit 1; }}
cd $HOME/NeuFlow_v3

CKPT_DIR=/scratch/$USER/neuflow_ckpts/{name}
mkdir -p "$CKPT_DIR"

$PY train.py \
  --stage {stage} \
  --implicit --sparse_loss --head convex{extra} \
  --num_sparse_points 4096 --adaptive_query_ratio 0.5 --no_query_jitter \
  --batch_size 16 --num_workers 8 --seed 1234 \
  --lr 2e-4 --onecycle --gamma 0.8 \
  --train_iters_s16 1 --train_iters_s8 8 \
  --num_steps 100000 --val_freq 5000 --val_dataset none \
  --max_flow 400 \
  --resume neuflow_mixed.pth \
  --checkpoint_dir "$CKPT_DIR"

echo "DONE {name}"
